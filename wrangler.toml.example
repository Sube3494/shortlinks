#:schema node_modules/wrangler/config-schema.json
name = "shortlinks"
main = "src/index.ts"
compatibility_date = "2026-01-09"

[[d1_databases]]
binding = "DB"
database_name = "shortlinks-db"
database_id = "YOUR_DATABASE_ID_HERE" # 请替换为您自己的 Database ID

[assets]
directory = "./static"
binding = "ASSETS"
