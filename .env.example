# ==============================================================================
# 核心安全配置 (Security)
# ==============================================================================

# [必需] 管理员密钥
# 用于访问后台管理界面。请务必修改为一个长且复杂的字符串。
ADMIN_KEY=your-super-secret-key-change-me

# ==============================================================================
# 网络配置 (Network)
# ==============================================================================

# [可选] 宿主机端口 (Host Port)
# docker-compose 映射到宿主机的端口。
HOST_PORT=18000

# [可选] 应用内部端口 (Internal Port)
# 容器内部应用监听的端口，通常无需修改。
APP_PORT=8000

# [可选] 短链基础 URL
# 示例: https://s.sube.top
# 留空: 系统将自动根据请求头 (Host) 推导域名，实现"零配置"部署。
BASE_URL=

# [可选] 自定义管理后台路径
# 默认值: /admin
# 如果你想隐藏后台入口，可以设置此项，例如 /my-secret-admin
ADMIN_PATH=/admin

# ==============================================================================
# 数据库配置 (Database)
# ==============================================================================

# [可选] 数据库连接字符串
# 默认为 SQLite 文件数据库。
DATABASE_URL=file:./data/shortlinks.db

# ==============================================================================
# Cloudflare 部署/CI 配置 (Deployment / CI)
# ==============================================================================

# Cloudflare 账户 ID (从 CF Dashboard URL 中获取)
# CLOUDFLARE_ACCOUNT_ID=...

# Cloudflare API 令牌 (需要有 Workers 编辑权限)
# CLOUDFLARE_API_TOKEN=...
