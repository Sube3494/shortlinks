# ==============================================================================
# 应用运行变量 (Runtime Configuration)
# 这些变量控制应用程序的行为，在本地开发、Docker 或 Cloudflare Dashboard 中设置。
# ==============================================================================

# [必需] 管理员密钥
# 用于访问后台管理界面。请务必修改为一个长且复杂的字符串。
ADMIN_KEY=your-super-secret-key-change-me

# [可选] 短链基础 URL
# 示例: https://s.sube.top
# 留空: 系统将自动根据请求头 (Host) 推导域名，实现"零配置"部署。
# BASE_URL=

# [可选] 自定义管理后台路径
# 默认值: /admin
# 如果你想隐藏后台入口，可以设置此项，例如 /my-secret-admin
# ADMIN_PATH=/admin

# ==============================================================================
# 本地开发模式开关 (Local Development Toggle)
# 仅用于本地 `pnpm dev`
# ==============================================================================

# [可选] 数据库连接字符串
# 1. 启用本地 SQLite 模式: 取消下方注释。`pnpm dev` 将自动切换到 Node.js 环境并使用此文件。
# 2. 启用 Cloudflare D1 模式: 保持注释状态。`pnpm dev` 将使用模拟的 D1 数据库。
# DATABASE_URL=file:./data/shortlinks.db

# ==============================================================================
# Cloudflare 部署/CI 配置 (Deployment / CI)
# 这些变量通常用于 CI/CD 流水线或本地 Wrangler CLI 部署指令
# ==============================================================================

# Cloudflare 账户 ID (从 CF Dashboard URL 中获取)
# CLOUDFLARE_ACCOUNT_ID=...

# Cloudflare API 令牌 (需要有 Workers 编辑权限)
# CLOUDFLARE_API_TOKEN=...

# D1 数据库 ID (通常在 wrangler.toml 中自动管理，但 CI 环境可能需要覆盖)
# D1_DATABASE_ID=...
