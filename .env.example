### 
# ==================== 数据库配置 ====================
# 数据库连接字符串 (通用)
# - 留空使用 SQLite 本地数据库 (适合 Docker 本地开发)
# - 配置 MySQL 连接字符串 (适合独立服务器/RDS 环境)
# - 配置 D1 独立变量 (适合 Cloudflare Workers 环境)
# DATABASE_URL=

# 方案 A: Cloudflare D1 (Cloudflare Workers 推荐)
# 需要在 CF 控制面板创建 API Token 并开启 D1 编辑权限
# CLOUDFLARE_ACCOUNT_ID=您的_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN=您的_API_TOKEN
# D1_DATABASE_ID=您的_D1_DATABASE_ID

# 方案 B: MySQL (支持各厂商云数据库/TiDB)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=your-password
# DB_DATABASE=shortlinks

# ==================== 应用配置 ====================
# 短链服务基础 URL (用于生成完整短链)
# - 可选：留空则自动根据请求头识别当前域名 (推荐)
# - 如果您使用了 CDN 或代理导致识别不准，请在此手动指定
# BASE_URL=https://your-domain.com

# ==================== 管理员配置 ====================
# 超级管理员密钥 (用于保护 /admin 等管理路径)
# ADMIN_KEY=your-super-secret-admin-key-here
# 自定义管理后台路径 (默认 /admin), 建议修改以增加隐蔽性
# ADMIN_PATH=/admin

# ==================== 站长验证文件配置 ====================
# 微信/其他站长工具的验证文件 (可选)
# VERIFICATION_FILENAME=09bbc0.txt
# VERIFICATION_CONTENT=27a1dbf4...
